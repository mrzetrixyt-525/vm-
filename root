############################################################

############################
# ROOTFS DIRECTORY
############################

ROOTFS_DIR="$(pwd)"

export PATH="$PATH:$HOME/.local/usr/bin"

############################
# SETTINGS
############################

MAX_RETRIES=50
TIMEOUT=10

############################
# COLORS
############################

RESET='\033[0m'

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'

############################
# ARCH DETECTION
############################

ARCH="$(uname -m)"

case "$ARCH" in
    x86_64)
        ARCH_ALT="amd64"
        ;;
    aarch64|arm64)
        ARCH_ALT="arm64"
        ;;
    *)
        echo -e "${RED}[ERROR] Unsupported architecture: $ARCH${RESET}"
        exit 1
        ;;
esac

