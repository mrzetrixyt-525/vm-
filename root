#!/bin/sh

############################################################
#                                                          #
#                 RGNODES™ PROOT SYSTEM                    #
#                   Ubuntu 22.04 LTS VM                    #
#                                                          #
#       Fast • Stable • Optimized • KVM & Dedicated IP     #
