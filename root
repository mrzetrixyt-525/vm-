# --- DEPENDENCY VERIFICATION ---
verify_host_deps() {
    log_info "Verifying host system prerequisites..."
    mkdir -p "$RGNODES_ROOT"
    
    for cmd in wget curl tar proot; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            log_warn "Missing required host package: $cmd. Installing automatically..."
            if command -v apt >/dev/null 2>&1; then
                apt update -y && apt install -y wget curl tar proot git
            elif command -v apk >/dev/null 2>&1; then
                apk add --no-cache wget curl tar proot git
            else
                log_error "Package manager not supported. Install wget, curl, tar, proot manually."
            fi
            break
        fi
    done
    log_success "Host prerequisites verified."
}

# --- ROOTFS PROVISIONING ---
provision_rootfs() {
    local ubuntu_url="https://cdimage.ubuntu.com/ubuntu-base/releases/22.04/release/ubuntu-base-22.04.5-base-${ARCH_ALT}.tar.gz"
    log_info "Fetching Ubuntu 22.04.5 LTS RootFS (${ARCH_ALT})..."
    
    if ! wget -q --show-progress --tries="$MAX_RETRIES" --timeout="$TIMEOUT" -O /tmp/rgnodes_fs.tar.gz "$ubuntu_url"; then
        log_error "Failed to download Ubuntu RootFS from official mirror."
    fi

    log_info "Extracting RootFS into RGNODES core storage..."
    tar -xpf /tmp/rgnodes_fs.tar.gz -C "$RGNODES_ROOT"
    rm -f /tmp/rgnodes_fs.tar.gz
    log_success "RootFS successfully provisioned."
}

# --- SYSTEM CONFIGURATION & SHIMS ---
configure_environment() {
    log_info "Configuring RGNODES™ system environment, shims, and security..."

    # Resolv & Hostname
    printf "nameserver 1.1.1.1\nnameserver 8.8.8.8\n" > "$RGNODES_ROOT/etc/resolv.conf"
    echo "rgnodes-vps" > "$RGNODES_ROOT/etc/hostname"
    echo "127.0.0.1 localhost rgnodes-vps" > "$RGNODES_ROOT/etc/hosts"
    chmod 1777 "$RGNODES_ROOT/tmp"
    mkdir -p "$RGNODES_ROOT/run/sshd" "$RGNODES_ROOT/var/run/sshd"

    # Professional MOTD
    cat << 'MOTD' > "$RGNODES_ROOT/etc/motd"
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  RGNODES™ High-Performance Cloud Infrastructure (SG-Node)
  System: Ubuntu 22.04.5 LTS (GNU/Linux 5.15+ x86_64)
  Access: Full Root Privilege | User: root@rgnodes-vps
  SSH Service: Active on Port 2222
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MOTD

    # Advanced systemctl compatibility shim
    cat << 'SYSCTL' > "$RGNODES_ROOT/usr/local/bin/systemctl"
#!/usr/bin/env bash
ACTION="$1"
SERVICE="${2:-}"
case "$ACTION" in
    start|stop|restart|status|reload)
        if command -v service >/dev/null 2>&1; then
            service "$SERVICE" "$ACTION"
        else
            echo "[RGNODES-SHIM] Executed service $SERVICE $ACTION"
        fi
        ;;
    enable|disable)
        echo "[RGNODES-SHIM] Unit $SERVICE marked as $ACTION"
        ;;
    daemon-reload)
        echo "[RGNODES-SHIM] Systemd unit files reloaded."
        ;;
    *)
        if [ -n "$ACTION" ]; then
            service "$@"
        fi
        ;;
esac
SYSCTL
    chmod +x "$RGNODES_ROOT/usr/local/bin/systemctl"

    # First-boot bootstrap script inside PRoot
    cat << 'BOOTSTRAP' > "$RGNODES_ROOT/root/.bashrc"
export PS1='\[\e[1;35m\]root@rgnodes-vps\[\e[0m\]:\[\e[1;36m\]\w\[\e[0m\]# '
cat /etc/motd

if [ ! -f /root/.rgnodes_initialized ]; then
    echo -e "\e[1;33m[*] Initializing RGNODES™ Core Packages (APT, Python3-Pip, OpenSSH)...\e[0m"
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Singapore
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

    apt update -y && apt upgrade -y
    apt install -y sudo curl wget nano vim git htop net-tools iproute2 openssh-server ca-certificates software-properties-common zip unzip screen tmux python3 python3-pip

    # Auto-generate secure SSH root password
    SSH_PASS="$(tr -dc 'A-Za-z0-9@#$%' </dev/urandom | head -c 14)"
    echo "root:${SSH_PASS}" | chpasswd
    echo "$SSH_PASS" > /root/ssh_master_password.txt
    
    ssh-keygen -A >/dev/null 2>&1
    sed -i 's/#Port 22/Port 2222/' /etc/ssh/sshd_config
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

    touch /root/.rgnodes_initialized
    echo -e "\e[1;32m[✔] RGNODES™ Setup Complete! Generated Root Password: ${SSH_PASS}\e[0m"
fi

# Ensure SSH daemon runs on Port 2222
if ! pgrep -x "sshd" >/dev/null 2>&1; then
    /usr/sbin/sshd -p 2222 >/dev/null 2>&1
fi

if [ -f /root/ssh_master_password.txt ]; then
    echo -e "\e[1;36m[SSH ACCESS INFO]\e[0m Local: \e[1;37mssh root@127.0.0.1 -p 2222\e[0m | Password: \e[1;33m$(cat /root/ssh_master_password.txt)\e[0m"
fi
BOOTSTRAP

    touch "$RGNODES_ROOT/.installed"
    log_success "Environment configured successfully."
}

# --- TELEMETRY DISPLAY ---
show_telemetry() {
    local ram_total cpu_cores disk_total public_ip geo_loc
    ram_total="$(free -m 2>/dev/null | awk '/Mem:/ {print $2}')"
    cpu_cores="$(nproc 2>/dev/null || echo 1)"
    disk_total="$(df -h / 2>/dev/null | awk 'NR==2 {print $2}')"
    public_ip="$(curl -s --max-time 3 https://api.ipify.org || echo "N/A")"
    geo_loc="$(curl -s --max-time 3 http://ip-api.com/line/${public_ip}?fields=city,country 2>/dev/null | tr '\n' ', ' | sed 's/, $//')"

    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${GREEN}                  RGNODES™ LIVE TELEMETRY                         ${RESET}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${YELLOW} Hostname    :${RESET} root@rgnodes-vps"
    echo -e "${YELLOW} Public IP   :${RESET} ${WHITE}${public_ip}${RESET}"
    echo -e "${YELLOW} DC Location :${RESET} ${WHITE}${geo_loc:-Singapore (SG)}${RESET}"
    echo -e "${YELLOW} Resources   :${RESET} ${WHITE}${cpu_cores} vCPU | ${ram_total:-512} MB RAM | ${disk_total:-10G} Disk${RESET}"
    echo -e "${YELLOW} Watchdog    :${RESET} ${GREEN}Active (24/7 Auto-Respawn Ready)${RESET}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""
}

# --- MAIN EXECUTION PIPELINE ---
show_banner
verify_host_deps

if [ ! -f "$RGNODES_ROOT/.installed" ]; then
    provision_rootfs
    configure_environment
fi

show_telemetry

# --- ENTERPRISE WATCHDOG LOOP (24/7 AUTO-RESPAWN) ---
log_info "Launching RGNODES™ PRoot Virtual Machine..."
while true; do
    proot \
        --rootfs="$RGNODES_ROOT" \
        -0 \
        -w /root \
        -b /dev \
        -b /sys \
        -b /proc \
        -b /tmp \
        -b /etc/resolv.conf \
        --kill-on-exit \
        /usr/bin/env -i \
        HOME=/root \
        HOSTNAME=rgnodes-vps \
        TERM="$TERM" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        /bin/bash --login

    exit_code=$?
    if [ "$exit_code" -eq 0 ]; then
        log_warn "RGNODES™ VM exited normally."
        break
    fi
    log_warn "Session interrupted (Exit Code: $exit_code). Respawning container in 3 seconds..."
    sleep 3
done
