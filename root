#!/bin/sh

############################################################
#                                                          #
#                 RGNODES™ PROOT SYSTEM                    #
#                   Ubuntu 22.04 LTS VM                    #
#                                                          #
#     High-Performance KVM • Dedicated IP • Cloudflare     #
#                      24/7 PM2 Ready                      #
#                                                          #
############################################################

ROOTFS_DIR="$(pwd)"
export PATH="$PATH:$HOME/.local/usr/bin:/usr/local/bin"

MAX_RETRIES=50
TIMEOUT=10

RESET='\033[0m'
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'

ARCH="$(uname -m)"
case "$ARCH" in
    x86_64) ARCH_ALT="amd64" ;;
    aarch64|arm64) ARCH_ALT="arm64" ;;
    *) echo -e "${RED}[ERROR] Unsupported architecture: $ARCH${RESET}"; exit 1 ;;
esac

show_logo() {
clear
echo -e "${MAGENTA}"
cat << 'EOF'
██████╗  ██████╗ ███╗   ██╗ ██████╗ ██████╗ ███████╗███████╗
██╔══██╗██╔════╝ ████╗  ██║██╔═══██╗██╔══██╗██╔════╝██╔════╝
██████╔╝██║  ███╗██╔██╗ ██║██║   ██║██║  ██║█████╗  ███████╗
██╔══██╗██║   ██║██║╚██╗██║██║   ██║██╔══██║██╔══╝  ╚════██║
██║  ██║╚██████╔╝██║ ╚████║╚██████╔╝██████╔╝███████╗███████║
╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝ ╚═════╝ ╚═════╝ ╚══════╝╚══════╝
EOF
echo -e "${RESET}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}          RGNODES™ Ubuntu 22.04 LTS Proot VM${RESET}"
echo -e "${YELLOW}       High-Performance KVM & Cloudflare Edition${RESET}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
}

install_dependencies() {
echo -e "${CYAN}[*] Checking and installing core dependencies...${RESET}"
if command -v apt >/dev/null 2>&1; then
    apt update -y
    apt install -y wget curl tar xz-utils proot iproute2 net-tools nodejs npm
elif command -v apk >/dev/null 2>&1; then
    apk add --no-cache wget curl tar xz proot iproute2 net-tools nodejs npm
elif command -v yum >/dev/null 2>&1; then
    yum install -y wget curl tar xz proot iproute2 net-tools nodejs npm
fi

# Ensure PM2 is installed globally for 24/7 uptime management
if ! command -v pm2 >/dev/null 2>&1; then
    echo -e "${YELLOW}[*] Installing PM2 for 24/7 process management...${RESET}"
    npm install -g pm2 || true
fi

# Install Cloudflared for secure port exposure & Cloudflare support
if ! command -v cloudflared >/dev/null 2>&1; then
    echo -e "${YELLOW}[*] Installing Cloudflare Tunnel (cloudflared)...${RESET}"
    if [ "$ARCH_ALT" = "amd64" ]; then
        curl -L --output /tmp/cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64
    else
        curl -L --output /tmp/cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64
    fi
    chmod +x /tmp/cloudflared
    mkdir -p /usr/local/bin
    mv /tmp/cloudflared /usr/local/bin/cloudflared || cp /tmp/cloudflared "$ROOTFS_DIR/usr/local/bin/cloudflared"
fi
}

detect_dedicated_ipv4() {
    echo -e "${CYAN}[*] Auto-detecting dedicated IPv4 address...${RESET}"
    DETECTED_IP=$(ip -4 addr show scope global 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '^172\.' | head -n 1)
    if [ -z "$DETECTED_IP" ] || [ "$DETECTED_IP" = "127.0.0.1" ]; then
        DETECTED_IP=$(curl -s --max-time 3 https://api.ipify.org || curl -s --max-time 3 https://ifconfig.me)
    fi
    if [ -z "$DETECTED_IP" ]; then
        DEDICATED_IPV4="Unavailable"
    else
        DEDICATED_IPV4="$DETECTED_IP"
    fi
    echo -e "${GREEN}[+] Dedicated IPv4 Detected: ${WHITE}$DEDICATED_IPV4${RESET}"
}

install_ubuntu() {
UBUNTU_URL="https://cdimage.ubuntu.com/ubuntu-base/releases/22.04/release/ubuntu-base-22.04.5-base-${ARCH_ALT}.tar.gz"
echo -e "${CYAN}[*] Downloading Ubuntu 22.04 RootFS...${RESET}"
wget --tries="$MAX_RETRIES" --timeout="$TIMEOUT" --show-progress --no-hsts -O /tmp/rootfs.tar.gz "$UBUNTU_URL"
if [ ! -f /tmp/rootfs.tar.gz ]; then
    echo -e "${RED}[ERROR] Failed to download Ubuntu RootFS.${RESET}"
    exit 1
fi
echo -e "${GREEN}[*] Extracting Ubuntu filesystem...${RESET}"
mkdir -p "$ROOTFS_DIR"
tar -xpf /tmp/rootfs.tar.gz -C "$ROOTFS_DIR"
if [ $? -ne 0 ]; then
    echo -e "${RED}[ERROR] Extraction failed.${RESET}"
    exit 1
fi
rm -f /tmp/rootfs.tar.gz
}

download_proot() {
mkdir -p "$ROOTFS_DIR/usr/local/bin"
echo -e "${CYAN}[*] Downloading PRoot binary...${RESET}"
wget --tries="$MAX_RETRIES" --timeout="$TIMEOUT" --show-progress --no-hsts -O "$ROOTFS_DIR/usr/local/bin/proot" "https://proot.gitlab.io/proot/bin/proot"
chmod +x "$ROOTFS_DIR/usr/local/bin/proot"
}

configure_system() {
echo -e "${CYAN}[*] Configuring Ubuntu environment, permissions & hostname...${RESET}"
echo "nameserver 1.1.1.1" > "$ROOTFS_DIR/etc/resolv.conf"
echo "nameserver 8.8.8.8" >> "$ROOTFS_DIR/etc/resolv.conf"

echo "rgnodes-vps" > "$ROOTFS_DIR/etc/hostname"
echo "127.0.0.1 localhost rgnodes-vps" > "$ROOTFS_DIR/etc/hosts"

cat << 'EOF' > "$ROOTFS_DIR/root/setup.sh"
#!/bin/bash
export DEBIAN_FRONTEND=noninteractive
apt update -y
apt install -y sudo curl wget nano vim git htop neofetch net-tools openssh-server ca-certificates software-properties-common zip unzip screen tmux python3 python3-pip

echo "root:root" | chpasswd
mkdir -p /var/run/sshd

sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
sed -i 's/PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config
sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config

service ssh start || /usr/sbin/sshd

# Run remote RGNODES MOTD Installer if available
curl -sSL https://raw.githubusercontent.com/mrzetrixyt-525/vm-/main/MOTD-Installer -o /tmp/motd-installer && chmod +x /tmp/motd-installer && /tmp/motd-installer || true

clear
echo ""
echo "======================================"
echo "      RGNODES™ UBUNTU READY"
echo "======================================"
echo ""
neofetch
EOF

chmod +x "$ROOTFS_DIR/root/setup.sh"
chmod 755 "$ROOTFS_DIR"
touch "$ROOTFS_DIR/.installed"
}

show_system_info() {
RAM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
RAM_USED=$(free -m | awk '/Mem:/ {print $3}')
RAM_FREE=$(free -m | awk '/Mem:/ {print $4}')

CPU_MODEL=$(grep -m 1 "model name" /proc/cpuinfo | cut -d ':' -f2 | sed 's/^[ \t]*//')
[ -z "$CPU_MODEL" ] && CPU_MODEL="KVM Dedicated Virtual Processor"
CPU_CORES=$(nproc)

DISK_TOTAL=$(df -h / | awk 'NR==2 {print $2}')
DISK_USED=$(df -h / | awk 'NR==2 {print $3}')
DISK_FREE=$(df -h / | awk 'NR==2 {print $4}')

HOST_NAME="rgnodes-vps"
KERNEL_VER=$(uname -r)
UPTIME_INFO=$(uptime -p)

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}RGNODES™ SYSTEM & HARDWARE SPECIFICATIONS${RESET}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
echo -e "${YELLOW}Provider:${RESET} RGNODES™ Infrastructure"
echo -e "${YELLOW}Virtualization:${RESET} KVM High-Performance Support"
echo -e "${YELLOW}OS:${RESET} Ubuntu 22.04 LTS"
echo -e "${YELLOW}Architecture:${RESET} $ARCH"
echo -e "${YELLOW}Kernel:${RESET} $KERNEL_VER"
echo -e "${YELLOW}Hostname:${RESET} $HOST_NAME"
echo ""
echo -e "${GREEN}CPU Performance (Host Mirrored)${RESET}"
echo -e "CPU Model : ${WHITE}$CPU_MODEL${RESET}"
echo -e "CPU Cores : ${WHITE}$CPU_CORES Cores Activated${RESET}"
echo ""
echo -e "${GREEN}RAM Allocation (Host Mirrored)${RESET}"
echo -e "Total RAM : ${WHITE}${RAM_TOTAL} MB${RESET}"
echo -e "Used RAM  : ${WHITE}${RAM_USED} MB${RESET}"
echo -e "Free RAM  : ${WHITE}${RAM_FREE} MB${RESET}"
echo ""
echo -e "${GREEN}Storage Allocation (Host Mirrored)${RESET}"
echo -e "Disk Total : ${WHITE}$DISK_TOTAL${RESET}"
echo -e "Disk Used  : ${WHITE}$DISK_USED${RESET}"
echo -e "Disk Free  : ${WHITE}$DISK_FREE${RESET}"
echo ""
echo -e "${GREEN}Network & Dedicated IP Configuration${RESET}"
echo -e "Dedicated IPv4 : ${WHITE}${DEDICATED_IPV4}${RESET}"
echo -e "SSH Status     : ${GREEN}Auto-Configured (100% Working)${RESET}"
echo -e "Default Login  : ${WHITE}root / root${RESET}"
echo ""
echo -e "${GREEN}Container Runtime & 24/7 PM2${RESET}"
echo -e "RootFS Path    : ${WHITE}$ROOTFS_DIR${RESET}"
echo -e "System Uptime  : ${WHITE}$UPTIME_INFO${RESET}"
echo -e "PM2 Status     : ${GREEN}Ready for 24/7 deployment${RESET}"
echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
echo -e "${MAGENTA}[*] Launching RGNODES™ High-Performance VM...${RESET}"
echo ""
}

show_logo
install_dependencies
detect_dedicated_ipv4

if [ ! -f "$ROOTFS_DIR/.installed" ]; then
    echo -e "${YELLOW}[*] First launch detected. Initializing RGNODES™ setup...${RESET}"
    install_ubuntu
    download_proot
    configure_system
    echo -e "${GREEN}[*] RGNODES™ Ubuntu installation completed successfully.${RESET}"
fi

show_system_info

exec "$ROOTFS_DIR/usr/local/bin/proot" \
--rootfs="$ROOTFS_DIR" \
-0 \
-w /root \
-b /dev \
-b /sys \
-b /proc \
-b /tmp \
-b /etc/resolv.conf \
--kill-on-exit \
/usr/bin/env -i \
HOME=/root \
TERM="$TERM" \
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
/bin/bash --login
