RAM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
RAM_USED=$(free -m | awk '/Mem:/ {print $3}')
RAM_FREE=$(free -m | awk '/Mem:/ {print $4}')

CPU_MODEL=$(grep -m 1 "model name" /proc/cpuinfo | cut -d ':' -f2 | sed 's/^[ \t]*//')
[ -z "$CPU_MODEL" ] && CPU_MODEL="KVM Dedicated Virtual Processor"
CPU_CORES=$(nproc)

DISK_TOTAL=$(df -h / | awk 'NR==2 {print $2}')
DISK_USED=$(df -h / | awk 'NR==2 {print $3}')
DISK_FREE=$(df -h / | awk 'NR==2 {print $4}')

HOST_NAME="rgnodes-vps"
KERNEL_VER=$(uname -r)
UPTIME_INFO=$(uptime -p)

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}RGNODES™ SYSTEM & HARDWARE SPECIFICATIONS${RESET}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
echo -e "${YELLOW}Provider:${RESET} RGNODES™ Infrastructure"
echo -e "${YELLOW}Virtualization:${RESET} KVM High-Performance Support"
echo -e "${YELLOW}OS:${RESET} Ubuntu 22.04 LTS"
echo -e "${YELLOW}Architecture:${RESET} $ARCH"
echo -e "${YELLOW}Kernel:${RESET} $KERNEL_VER"
echo -e "${YELLOW}Hostname:${RESET} $HOST_NAME"
echo ""
echo -e "${GREEN}CPU Performance (Host Mirrored)${RESET}"
echo -e "CPU Model : ${WHITE}$CPU_MODEL${RESET}"
echo -e "CPU Cores : ${WHITE}$CPU_CORES Cores Activated${RESET}"
echo ""
echo -e "${GREEN}RAM Allocation (Host Mirrored)${RESET}"
echo -e "Total RAM : ${WHITE}${RAM_TOTAL} MB${RESET}"
echo -e "Used RAM  : ${WHITE}${RAM_USED} MB${RESET}"
echo -e "Free RAM  : ${WHITE}${RAM_FREE} MB${RESET}"
echo ""
echo -e "${GREEN}Storage Allocation (Host Mirrored)${RESET}"
echo -e "Disk Total : ${WHITE}$DISK_TOTAL${RESET}"
echo -e "Disk Used  : ${WHITE}$DISK_USED${RESET}"
echo -e "Disk Free  : ${WHITE}$DISK_FREE${RESET}"
echo ""
echo -e "${GREEN}Network & Dedicated IP Configuration${RESET}"
echo -e "Dedicated IPv4 : ${WHITE}${DEDICATED_IPV4}${RESET}"
echo -e "SSH Status     : ${GREEN}Auto-Configured (100% Working)${RESET}"
echo -e "Default Login  : ${WHITE}root / root${RESET}"
echo ""
echo -e "${GREEN}Container Runtime${RESET}"
echo -e "RootFS Path    : ${WHITE}$ROOTFS_DIR${RESET}"
echo -e "System Uptime  : ${WHITE}$UPTIME_INFO${RESET}"
echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
echo -e "${MAGENTA}[*] Launching RGNODES™ High-Performance VM...${RESET}"
echo ""
}

############################
# MAIN EXECUTION
############################

show_logo

install_dependencies

detect_dedicated_ipv4

if [ ! -f "$ROOTFS_DIR/.installed" ]; then

    echo -e "${YELLOW}[*] First launch detected. Initializing RGNODES™ setup...${RESET}"

    install_ubuntu

    download_proot

    configure_system

    echo -e "${GREEN}[*] RGNODES™ Ubuntu installation completed successfully.${RESET}"

fi

show_system_info

############################
# START PROOT
############################

exec "$ROOTFS_DIR/usr/local/bin/proot" \
--rootfs="$ROOTFS_DIR" \
-0 \
-w /root \
-b /dev \
-b /sys \
-b /proc \
-b /tmp \
-b /etc/resolv.conf \
--kill-on-exit \
/usr/bin/env -i \
HOME=/root \
TERM="$TERM" \
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
/bin/bash --login
