set -Eeuo pipefail

# --- CONFIGURATION & PATHS ---
RGNODES_ROOT="${PWD}/rgnodes-core"
MAX_RETRIES=5
TIMEOUT=15
SSH_PORT=2222

# --- COLOR PALETTE & UI STYLING ---
ESC="\033["
RESET="${ESC}0m"
BOLD="${ESC}1m"
DIM="${ESC}2m"
RED="${ESC}31m"
GREEN="${ESC}32m"
YELLOW="${ESC}33m"
BLUE="${ESC}34m"
MAGENTA="${ESC}35m"
CYAN="${ESC}36m"
WHITE="${ESC}37m"
BG_DARK="${ESC}40m"

# --- LOGGING UTILITIES ---
log_info()    { echo -e "${CYAN}[ℹ]${RESET} ${WHITE}$1${RESET}"; }
log_success() { echo -e "${GREEN}[✔]${RESET} ${GREEN}$1${RESET}"; }
log_warn()    { echo -e "${YELLOW}[⚠]${RESET} ${YELLOW}$1${RESET}"; }
log_error()   { echo -e "${RED}[✖] $1${RESET}" >&2; exit 1; }

# --- CLEANUP TRAP ---
cleanup() {
    echo -e "\n${MAGENTA}[*] RGNODES™ Session detached cleanly. Core services persisting.${RESET}"
}
trap cleanup EXIT

# --- ARCHITECTURE DETECTION ---
detect_arch() {
    local arch
    arch="$(uname -m)"
    case "$arch" in
        x86_64)     echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        *)          log_error "Unsupported host architecture: $arch" ;;
    esac
}

ARCH_ALT="$(detect_arch)"

