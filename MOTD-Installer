#!/bin/bash
# ==========================================
# RGNODES™ Custom MOTD Installer (FIXED PRO)
# 10000% WORKING - TTY & PATH SAFE
# ==========================================

set -e

echo "🔧 Deep fixing and Installing RGNODES™ MOTD..."

# ================================
# 1. CLEAN UP BROKEN PAM LOGIC
# ================================
echo "🧹 Removing broken PAM configurations..."

# Restore default PAM if backups exist
[ -f /etc/pam.d/sshd.bak ] && cp /etc/pam.d/sshd.bak /etc/pam.d/sshd
[ -f /etc/pam.d/login.bak ] && cp /etc/pam.d/login.bak /etc/pam.d/login

# Force delete any custom pam_exec and pam_motd lines added before
sed -i '/pam_exec.so/d' /etc/pam.d/sshd
sed -i '/pam_exec.so/d' /etc/pam.d/login
sed -i '/pam_motd.so/d' /etc/pam.d/sshd
sed -i '/pam_motd.so/d' /etc/pam.d/login

# ================================
# 2. REMOVE ALL OLD UBUNTU MOTDS
# ================================
echo "🧹 Disabling default system MOTDs..."
chmod -x /etc/update-motd.d/* 2>/dev/null || true
rm -f /etc/motd /var/run/motd /run/motd.dynamic /etc/update-motd.d/00-rgnodes /etc/update-motd.d/00-atyrocloud

if [ -f /etc/default/motd-news ]; then
    sed -i 's/ENABLED=1/ENABLED=0/g' /etc/default/motd-news
fi

# ================================
# 3. CREATE THE REAL WORKING MOTD
# ================================
echo "✨ Generating highly-stable Profile MOTD..."

# Using profile.d ensures the script only runs when the user's terminal is ready
cat << 'EOF' > /etc/profile.d/99-rgnodes-motd.sh
#!/bin/bash

# Only run for interactive terminal sessions (fixes SFTP/SCP issues)
if [[ $- != *i* ]]; then return; fi

# ===== Colors =====
GREEN="\e[38;5;82m"
CYAN="\e[38;5;51m"
BLUE="\e[38;5;39m"
MAGENTA="\e[38;5;213m"
YELLOW="\e[38;5;220m"
GRAY="\e[38;5;245m"
RESET="\e[0m"

# ===== System Info =====
HOSTNAME=$(hostname)
OS=$(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')
KERNEL=$(uname -r)
UPTIME=$(uptime -p | sed 's/up //')

# Safe CPU Fetch
CPU=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{print 100 - $8"%"}')
if [ -z "$CPU" ]; then CPU="N/A"; fi

MEM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
MEM_USED=$(free -m | awk '/Mem:/ {print $3}')
if [ "$MEM_TOTAL" -gt 0 ]; then
    MEM_PERC=$((MEM_USED * 100 / MEM_TOTAL))
else
    MEM_PERC=0
fi

DISK=$(df -h / | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}')
IP=$(hostname -I | awk '{print $1}')
USERS=$(who | wc -l)
PROCS=$(ps -e --no-headers | wc -l)

echo ""

# ===== LOGO (FIXED RENDERING) =====
echo -e "${MAGENTA}"
echo '██████╗  ██████╗ ███╗   ██╗ ██████╗ ██████╗ ███████╗███████╗™'
echo '██╔══██╗██╔════╝ ████╗  ██║██╔══██╗██╔══██╗██╔════╝██╔════╝'
echo '██████╔╝██║  ██╗ ██╔██╗ ██║██║  ██║██║  ██║█████╗  ╚█████╗ '
echo '██╔══██╗██║  ╚██╗██║╚██╗██║██║  ██║██║  ██║██╔══╝  ╚═══██╗ '
echo '██║  ██║╚██████╔╝██║ ╚████║╚█████╔╝██████╔╝███████╗██████╔╝'
echo '╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚══╝ ╚════╝ ╚═════╝ ╚══════╝╚═════╝  '
echo -e "${RESET}"

# ===== HEADER =====
echo -e "${GREEN}🚀 Welcome to RGNODES™ Datacenter${RESET}"
echo -e "${BLUE}High Performance • Secure • Reliable Infrastructure${RESET}"
echo -e "${GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"

# ===== STATS =====
printf "${CYAN}%-18s${RESET} %s\n" "Hostname:" "$HOSTNAME"
printf "${CYAN}%-18s${RESET} %s\n" "OS:" "$OS"
printf "${CYAN}%-18s${RESET} %s\n" "Kernel:" "$KERNEL"
printf "${CYAN}%-18s${RESET} %s\n" "Uptime:" "$UPTIME"
printf "${CYAN}%-18s${RESET} %s\n" "CPU Usage:" "$CPU"
printf "${CYAN}%-18s${RESET} %sMB / %sMB (${YELLOW}%s%%${RESET})\n" "Memory:" "$MEM_USED" "$MEM_TOTAL" "$MEM_PERC"
printf "${CYAN}%-18s${RESET} %s\n" "Disk:" "$DISK"
printf "${CYAN}%-18s${RESET} %s\n" "Processes:" "$PROCS"
printf "${CYAN}%-18s${RESET} %s\n" "Users:" "$USERS"
printf "${CYAN}%-18s${RESET} %s\n" "IP:" "$IP"
echo -e "${GRAY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"

# ===== FOOTER =====
echo -e "${GREEN}Support:${RESET}  support@rgnodes.cloud"
echo -e "${GREEN}Discord:${RESET}  https://discord.gg/wJ5D5MHkUA"
echo -e "${GREEN}Website:${RESET}  https://www.rgnodes.qzz.io/"
echo -e "${MAGENTA}RGNODES™ — Free Hosting 💎${RESET}"
echo ""
EOF

chmod +x /etc/profile.d/99-rgnodes-motd.sh

# ================================
# RESTART SSH
# ================================
systemctl restart ssh 2>/dev/null || true

echo ""
echo "✅ RGNODES™ MOTD 10000% FIXED & INSTALLED"
echo "🚫 Buggy PAM module deleted"
echo "🔥 Logo and commands are fully guaranteed to work"
echo "➡ Disconnect and Reconnect to SSH to see it in action!"
